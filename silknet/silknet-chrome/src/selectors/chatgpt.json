{
  "provider": "chatgpt",
  "configVersion": 2,
  "match": {
    "origins": ["https://chatgpt.com"],
    "topFrameOnly": true
  },
  "selectors": {
    "composer": [
      { "by": "css", "value": "#prompt-textarea" },
      { "by": "role", "value": "textbox", "name": "Message ChatGPT" },
      { "by": "role", "value": "textbox", "name": "Ask ChatGPT" },
      { "by": "css", "value": "textarea" },
      { "by": "css", "value": "[contenteditable='true']" }
    ],
    "sendButton": [
      { "by": "aria-label", "value": "Send message" },
      { "by": "aria-label", "value": "Send prompt" },
      { "by": "aria-label", "value": "Send" },
      { "by": "data-testid", "value": "send-button" },
      { "by": "css", "value": "button[data-testid*='send']" },
      { "by": "css", "value": "form button[type='submit']" }
    ],
    "stopButton": [
      { "by": "aria-label", "value": "Stop generating" },
      { "by": "aria-label", "value": "Stop streaming" },
      { "by": "aria-label", "value": "Stop" },
      { "by": "data-testid", "value": "stop-button" },
      { "by": "css", "value": "button[data-testid*='stop']" },
      { "by": "css", "value": "button[aria-label*='Stop']" }
    ],
    "assistantTurn": [
      { "by": "css", "value": "[data-content-search-unit-key$=':assistant']" },
      { "by": "css", "value": "div:has(> h4[data-conversation-role='assistant'])" },
      { "by": "css", "value": "article[data-message-author-role=\"assistant\"]" },
      { "by": "css", "value": "[data-message-author-role=\"assistant\"]" }
    ],
    "assistantMessageBody": [
      { "by": "css", "value": "[data-markdown-text-style='assistant-message']" },
      { "by": "css", "value": "[data-message-author-role=\"assistant\"] .markdown" },
      { "by": "css", "value": ".markdown" }
    ],
    "userTurn": [
      { "by": "css", "value": "[data-content-search-unit-key$=':user']" },
      { "by": "css", "value": "div:has(> h4[data-conversation-role='user'])" },
      { "by": "css", "value": "article[data-message-author-role=\"user\"]" },
      { "by": "css", "value": "[data-message-author-role=\"user\"]" }
    ],
    "responseContainer": [
      { "by": "css", "value": "main" }
    ],
    "replyActionControls": [
      { "by": "css", "value": "span[data-chatgpt-agent-turn-start]" },
      { "by": "aria-label", "value": "Copy" },
      { "by": "aria-label", "value": "Copy to clipboard" },
      { "by": "aria-label", "value": "Regenerate" },
      { "by": "aria-label", "value": "Regenerate response" },
      { "by": "data-testid", "value": "copy-turn-action-button" },
      { "by": "css", "value": "button[data-testid*='copy']" }
    ]
  },
  "behavior": {
    "inputType": "textarea",
    "injectionMethod": "native-setter",
    "stabilityMs": 1800,
    "watchdogMs": 180000,
    "assistantTurnMarkerAttribute": "data-message-author-role",
    "assistantTurnMarkerValue": "assistant"
  }
}
