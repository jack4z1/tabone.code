{
  "provider": "claude",
  "configVersion": 1,
  "match": {
    "origins": ["https://claude.ai"],
    "topFrameOnly": true
  },
  "selectors": {
    "composer": [
      { "by": "css", "value": "div.ProseMirror[contenteditable='true']" },
      { "by": "role", "value": "textbox", "name": "Write your prompt to Claude" },
      { "by": "role", "value": "textbox", "name": "Reply to Claude..." },
      { "by": "css", "value": "div[contenteditable='true']" },
      { "by": "css", "value": "[data-testid='chat-input']" }
    ],
    "sendButton": [
      { "by": "aria-label", "value": "Send Message" },
      { "by": "aria-label", "value": "Send message" },
      { "by": "aria-label", "value": "Send" },
      { "by": "data-testid", "value": "send-button" },
      { "by": "css", "value": "button[aria-label*='Send']" },
      { "by": "css", "value": "fieldset button[type='button']:not([aria-label*='Attach'])" }
    ],
    "stopButton": [
      { "by": "aria-label", "value": "Stop Response" },
      { "by": "aria-label", "value": "Stop response" },
      { "by": "aria-label", "value": "Stop generating" },
      { "by": "aria-label", "value": "Stop" },
      { "by": "data-testid", "value": "stop-button" },
      { "by": "css", "value": "button[aria-label*='Stop']" }
    ],
    "assistantTurn": [
      { "by": "css", "value": "div[data-message-author='assistant']" },
      { "by": "css", "value": "div[data-testid*='assistant-message']" },
      { "by": "css", "value": "div.font-claude-message" },
      { "by": "css", "value": "[data-is-streaming]" }
    ],
    "assistantMessageBody": [
      { "by": "css", "value": "div.font-claude-message .grid-cols-1" },
      { "by": "css", "value": "div.font-claude-message" },
      { "by": "css", "value": "div.prose" },
      { "by": "css", "value": ".grid-cols-1" }
    ],
    "userTurn": [
      { "by": "css", "value": "div[data-message-author='user']" },
      { "by": "css", "value": "div[data-testid*='user-message']" },
      { "by": "css", "value": "div.font-user-message" }
    ],
    "responseContainer": [
      { "by": "css", "value": "main" },
      { "by": "css", "value": "div[data-testid='chat-messages']" }
    ],
    "replyActionControls": [
      { "by": "aria-label", "value": "Copy text" },
      { "by": "aria-label", "value": "Copy" },
      { "by": "aria-label", "value": "Retry" },
      { "by": "data-testid", "value": "copy-button" },
      { "by": "css", "value": "button[aria-label*='Copy']" }
    ]
  },
  "behavior": {
    "inputType": "contenteditable",
    "injectionMethod": "execCommand",
    "stabilityMs": 1800,
    "watchdogMs": 180000,
    "assistantTurnMarkerAttribute": "data-message-author",
    "assistantTurnMarkerValue": "assistant"
  }
}
