{
  "provider": "gemini",
  "configVersion": 1,
  "match": {
    "origins": ["https://gemini.google.com"],
    "topFrameOnly": true
  },
  "selectors": {
    "composer": [
      { "by": "css", "value": "div.ql-editor[contenteditable='true']" },
      { "by": "css", "value": "rich-textarea div[contenteditable='true']" },
      { "by": "role", "value": "textbox", "name": "Enter a prompt here" },
      { "by": "role", "value": "textbox", "name": "Ask Gemini" },
      { "by": "css", "value": "div.ql-editor" },
      { "by": "css", "value": "div[contenteditable='true']" }
    ],
    "sendButton": [
      { "by": "aria-label", "value": "Send message" },
      { "by": "aria-label", "value": "Send prompt" },
      { "by": "aria-label", "value": "Send" },
      { "by": "css", "value": "button.send-button" },
      { "by": "css", "value": "button[aria-label*='Send']" }
    ],
    "stopButton": [
      { "by": "aria-label", "value": "Stop response" },
      { "by": "aria-label", "value": "Stop generation" },
      { "by": "aria-label", "value": "Stop" },
      { "by": "css", "value": "button.stop-button" },
      { "by": "css", "value": "button[aria-label*='Stop']" }
    ],
    "assistantTurn": [
      { "by": "css", "value": "model-response" },
      { "by": "css", "value": "div[data-test-id='model-response']" },
      { "by": "css", "value": "div.response-container" },
      { "by": "css", "value": "div.model-response-text" },
      { "by": "css", "value": "message-content[is-response]" }
    ],
    "assistantMessageBody": [
      { "by": "css", "value": "message-content" },
      { "by": "css", "value": "div.model-response-text" },
      { "by": "css", "value": "div.markdown" },
      { "by": "css", "value": ".response-paragraph" }
    ],
    "userTurn": [
      { "by": "css", "value": "user-query" },
      { "by": "css", "value": "div[data-test-id='user-query']" },
      { "by": "css", "value": "div.query-container" }
    ],
    "responseContainer": [
      { "by": "css", "value": "main" },
      { "by": "css", "value": "chat-window" },
      { "by": "css", "value": "infinite-scroller" },
      { "by": "css", "value": "div.chat-history" }
    ],
    "replyActionControls": [
      { "by": "aria-label", "value": "Copy" },
      { "by": "aria-label", "value": "Copy text" },
      { "by": "aria-label", "value": "Good response" },
      { "by": "aria-label", "value": "Bad response" },
      { "by": "css", "value": "button[aria-label*='Copy']" }
    ]
  },
  "behavior": {
    "inputType": "contenteditable",
    "injectionMethod": "execCommand",
    "stabilityMs": 1800,
    "watchdogMs": 180000,
    "assistantTurnMarkerAttribute": "data-test-id",
    "assistantTurnMarkerValue": "model-response"
  }
}
