{
  "name": "silknet-vscode",
  "displayName": "Silknet — Local Grounding Bridge",
  "version": "0.1.0",
  "private": true,
  "publisher": "silknet",
  "description": "Silknet VS Code extension — local Grounding Agent bridge. Reads the open workspace (read-only), produces a bounded context report via a local Ollama model, and serves it to the Silknet Chrome debate extension over an authenticated 127.0.0.1-only WebSocket bridge.",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node build.mjs",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onCommand:silknet.startBridge",
    "onCommand:silknet.stopBridge",
    "onCommand:silknet.checkOllama",
    "onCommand:silknet.generateReport",
    "onCommand:silknet.designatePrimaryFolder"
  ],
  "contributes": {
    "commands": [
      {
        "command": "silknet.startBridge",
        "title": "Silknet: Start Bridge"
      },
      {
        "command": "silknet.stopBridge",
        "title": "Silknet: Stop Bridge"
      },
      {
        "command": "silknet.checkOllama",
        "title": "Silknet: Check Ollama Availability"
      },
      {
        "command": "silknet.generateReport",
        "title": "Silknet: Generate Grounding Report (read-only)"
      },
      {
        "command": "silknet.designatePrimaryFolder",
        "title": "Silknet: Designate Primary Workspace Folder"
      }
    ],
    "configuration": {
      "title": "Silknet",
      "properties": {
        "silknet.bridgePort": {
          "type": "number",
          "default": 8712,
          "description": "Port for the local Silknet bridge WebSocket broker (always bound to 127.0.0.1 only)."
        },
        "silknet.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the local Ollama server."
        },
        "silknet.ollamaModel": {
          "type": "string",
          "default": "llama3.2",
          "description": "Ollama model used for the grounding report's structure summary."
        }
      }
    }
  }
}
